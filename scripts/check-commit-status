#!/usr/bin/env bash
set -euo pipefail

echo "Checking unstaged and untracked files..."

changed_files="$(
  {
    git diff --name-only --diff-filter=ACMRD
    git ls-files --others --exclude-standard
  } | sort -u
)"

changed_matching() {
  echo "$changed_files" | grep -Eq "$1"
}

if [ -z "$changed_files" ]; then
  echo "No matching changed files found. Skipping checks."
  exit 0
fi

echo
echo "====== Changed files ======"
echo "$changed_files"
echo
echo "==========================="

if changed_matching '(^api/|^docker-compose\.dev\.yml$|^api/Gemfile|^api/Gemfile\.lock$)'; then
  echo "API files changed. Running RSpec..."
  scripts/get-branch-project bundle exec rspec

  echo "Running Rubocop..."
  scripts/get-branch-project bundle exec rubocop

  echo "Running Brakeman..."
  scripts/get-branch-project bundle exec brakeman -z
else
  echo "No API files changed. Skipping API checks."
fi

if changed_matching '^client/'; then
  echo "Client files changed. Running client lint..."
  npm --prefix client run lint

  echo "Running client format check..."
  npm --prefix client run format:check

  echo "Running client typecheck..."
  npm --prefix client run typecheck
else
  echo "No client files changed. Skipping client checks."
fi

echo "Checks passed."
