# The weekly group send, as a one-shot. Fired by slack-bot-weekly.timer — not
# enabled directly. Runs the exact same send as `npm run send-now`, then exits;
# nothing has to stay alive between Fridays.
#
# Install (alongside the .timer):
#   sudo cp deploy/slack-bot-weekly.service deploy/slack-bot-weekly.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now slack-bot-weekly.timer
#
# Adjust User/WorkingDirectory/node path to match the host (see README).
[Unit]
Description=slack-bot weekly group send
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=slackbot
WorkingDirectory=/opt/slack-bot
ExecStart=/usr/bin/node --env-file=.env src/bin/send-now.ts
