# The bot token decides WHICH workspace the bot hits — use your personal
# workspace's token in dev, and Viget's in prod. The code is identical either way.
# Needs scopes: users:read + users:read.email (list the workspace roster),
# chat:write + im:write (DM people), and usergroups:read (only if you use
# SLACK_USERGROUP_ID below).
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Optional. Leave blank to send to every active real person in the workspace
# (the default pool). Set it to a Slack user group ID (starts with "S", found in
# the group's URL or via usergroups.list) to instead target just that group's
# active members — handy for narrower testing.
SLACK_USERGROUP_ID=

# No-op real sends in dev; set to "true" to actually hit the workspace.
USE_SLACK=false

# Port for the interactivity endpoint (npm start).
PORT=3000

# Optional default recipient for `npm run send-demo`.
DEMO_USER_ID=
