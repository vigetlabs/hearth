SLACK_BOT_TOKEN=xoxb-...
SLACK_USER_TOKEN=xoxp-...
SLACK_SIGNING_SECRET=...

# Slack user group whose active members get the weekly Friday prompt.
# Find the ID in the group's URL, or via usergroups.list (starts with "S").
SLACK_USERGROUP_ID=S0XXXXXXX

# No-op real sends in dev; set to "true" to actually hit the workspace.
USE_SLACK=false

# Port for the interactivity endpoint (npm start).
PORT=3000

# Optional default recipient for `npm run send-demo`.
DEMO_USER_ID=
